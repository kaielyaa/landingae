# Salin file ini jadi .env.local, isi nilainya, JANGAN commit .env.local.

# --- Situs ---
# Alamat produksi lengkap tanpa garis miring di akhir, mis. domain final.
# Dipakai metadata, sitemap, robots, dan gambar OpenGraph. Kosong = pakai
# bawaan di src/lib/site.ts.
SITE_URL=

# --- Email (form Submit — notifikasi submission demo artist) ---
# Dipakai nanti pas form /submit dibikin fungsional beneran (masih
# static "Closed" sekarang). Provider bebas (Gmail App Password, SES,
# Resend SMTP, dst) — asal support SMTP standar.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Anka Entertainment"
SMTP_FROM_EMAIL=
# Email tujuan notifikasi submission masuk
SUBMISSION_TO_EMAIL=

# --- Sanity CMS ---
# Belum connect sekarang (semua data masih hardcode di src/lib/) —
# rencana migrasi ada di catatan.md. Isi begitu project Sanity dibuat.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
